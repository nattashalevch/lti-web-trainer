# Публичный HTTPS-адрес тренажёра (Render)
PUBLIC_URL=https://your-trainer.onrender.com
PORT=3000

# Любая длинная случайная строка (подписывает сессии ltik)
LTI_KEY=change-me-to-a-long-random-string

# MongoDB (локально: docker compose up -d mongo; на Render: строка Atlas)
MONGO_URL=mongodb://localhost:27017/lti-trainer

# Данные Moodle (заполнить после регистрации инструмента)
MOODLE_URL=https://your-moodle.example.com
MOODLE_CLIENT_ID=
# Необязательно: если адреса отличаются от стандартных
# MOODLE_AUTH_URL=
# MOODLE_TOKEN_URL=
# MOODLE_JWKS_URL=
